<!doctype html>
<html lang="{{ shop.locale }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ shop.name }}</title>
  <meta name="description" content=""> 
  <style>
    {{ settings.main_font | font_face  }}
    {{ settings.mid_font | font_face  }}
    {{ settings.bold_font | font_face  }}
    :root {
      --selectedMainFont: {{ settings.main_font.family  }};
      --selectedMainFontWeight: {{ settings.main_font.weight  }};
      --selectedMidFont: {{ settings.mid_font.family  }};
      --selectedMidFontWeight: {{ settings.mid_font.weight  }};
      --selectedBoldFont: {{ settings.bold_font.family  }};
      --selectedBoldFontWeight: {{ settings.bold_font.weight  }};
    }
  </style>
  {{ 'jb-styles.min.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  {% sections 'header-group' %}
  <main id="master-wrap-veloshop-cst">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {%- if settings.enabled_cart_drawer == true -%}
    {% assign crossIcon = 'cross.png' | asset_url %}
    <div id="drawer-master-wrap-cst">
      <div class="drawer-inner-wrap-cst">
        <div class="cart-title-wrap-cst">
          <h3 class="mst-semi-bold">Your Basket</h3>
          <a id="clear-all-cart-cst">Clear all</a>
        </div>
        <div id="drawer-dynamic-wrap-cst"></div>
        <div id="close-drawer-instance-cst">
           <img src="{{ crossIcon }}" alt="Close Drawer">
        </div>
      </div>
    </div>
  {%- endif -%}
  <script src="{{ 'jb-scripts.min.js' | asset_url }}" defer="defer"></script>
</body>
</html>