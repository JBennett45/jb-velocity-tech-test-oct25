[
  {
    "name": "theme_info",
    "theme_name": "Skeleton theme",
    "theme_version": "1.0.0",
    "theme_author": "THEME_AUTHOR",
    "theme_documentation_url": "https:\/\/THEME_DOCUMENTATION_URL.com\/",
    "theme_support_url": "https:\/\/THEME_SUPPORT_URL.com\/"
  }, 
  {
    "name": "General",
    "settings": [
      {
        "type": "image_picker",
        "id": "main_theme_logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 100,
        "max": 150,
        "step": 1,
        "unit": "px",
        "label": "Logo Width",
        "default": 133
      },
      {
        "type": "range",
        "id": "logo_height",
        "min": 10,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Logo Height",
        "default": 36
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "main_font",
        "label": "Body Font",
        "default": "montserrat_n4"
      },
      {
        "type": "font_picker",
        "id": "mid_font",
        "label": "MidWeight Title Font",
        "default": "montserrat_n5"
      },
           {
        "type": "font_picker",
        "id": "bold_font",
        "label": "Bold Title Font",
        "default": "montserrat_n7"
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "color",
        "id": "main_site_bg",
        "label": "Main Theme Background Colour:",
        "default": "#1E3563"
      }, 
      {
        "type": "color",
        "id": "hdr_ftr_color",
        "label": "Header & Footer Font Colour:",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Cart Settings",
    "settings": [
      {
        "type": "checkbox",
        "id": "enabled_cart_drawer",
        "label": "Enable Cart Drawer?",
        "default": true
      }
    ]
  }
]