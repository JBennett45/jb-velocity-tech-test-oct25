{% style %}
  #velocity-ftr-cst {
    background-color: {{ settings.main_site_bg }};
    color: {{ settings.hdr_ftr_color }}
  }
{% endstyle %}
<footer id="velocity-ftr-cst">
  <div class="container-cst">
    Footer container
  </div>
</footer>
{% schema %}
{
  "name": "Velocity Footer",
  "class": "sitewide-footer",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ]
}
{% endschema %}