
{% form 'cart', cart, class: 'cart-drawer-form' %}
  {% if cart.item_count == 0 %}
    <p class="cart-drawer-empty">Your cart is empty</p>
  {% else %}
    <div id="drawer-products-main-wrap-cst">
      {% for item in cart.items %}
        {% render 'product-cart-output' with item as product %}
      {% endfor %}
    </div>
    <footer class="cart-drawer-footer">
      {% if cart.total_discounts > 0 %}
        <div class="cart-drawer-footer-row">
          <h3>Discounts</h3>
          <span>{{ cart.total_discounts | money }}</span>
        </div>
      {% endif %}
      <div class="cart-drawer-footer-row">
        <h3>Subtotal</h3>
         <span>{{ cart.item_count }}</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <button type="submit" name="checkout" class="cart-drawer-button">Checkout</button>
    </footer>
  {% endif %}
{% endform %}

