
{% form 'cart', cart, class: 'cart-drawer-form' %}
  {% if cart.item_count == 0 %}
    <p class="cart-drawer-empty">Your cart is empty</p>
  {% else %}
    <div id="drawer-products-main-wrap-cst">
      {% for item in cart.items %}
        {% render 'product-cart-output' with item as product %}
      {% endfor %}
    </div>
    <footer class="cart-drawer-footer">
      {% if cart.total_discounts > 0 %}
        <div class="cart-drawer-footer-row">
          <h3>Discounts</h3>
          <span>{{ cart.total_discounts | money }}</span>
        </div>
      {% endif %}
      <div class="drawer-footer-cst">
        <div class="top-row-cst">
          <div class="cart-itemwrap-cst">
            <span class="cart-itemcount-cst">{{ cart.item_count }}</span>
            <span class="cart-itemlabel-cst">items</span>
          </div>
          <h4 class="mst-semi-bold">{{ cart.total_price | money }}</h4>
        </div>
        <div class="btn-row-cst">
          <a href="{{ routes.account_login_url }}" class="points-btn-cst">
            Earn 20 points with this order
          </a>
          <button type="submit" name="checkout" class="drawer-submit-btn-cst">
            <span class="mst-semi-bold">Checkout</span>
          </button>
      </div>
    </footer>
  {% endif %}
{% endform %}

